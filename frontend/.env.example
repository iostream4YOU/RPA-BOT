# Backend API (default path)
VITE_BACKEND_URL=https://api-rpa-dashboard.onrender.com/

# Optional: bypass backend and read Firestore directly from the browser.
# NOTE: This requires Firestore Security Rules that allow your users to read the data.
VITE_USE_FIRESTORE_DIRECT=false

# Firebase Web SDK config (from Firebase Console -> Project settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
